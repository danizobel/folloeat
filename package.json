{
  "name": "folloeat",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "pages:build": "node scripts/auto-migrate.mjs && npx @cloudflare/next-on-pages",
    "deploy": "node scripts/auto-migrate.mjs && npx @cloudflare/next-on-pages && wrangler pages deploy .vercel/output/static",
    "deploy:prod": "node scripts/auto-migrate.mjs --remote && npx @cloudflare/next-on-pages && wrangler pages deploy .vercel/output/static",
    "db:migrate": "node scripts/auto-migrate.mjs",
    "db:migrate:prod": "wrangler d1 execute folloeat-db --remote --file=./migrations/0001_init_schema.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.48.0",
    "next": "^15.1.4",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/d3": "^7.4.3",
    "@types/leaflet.markercluster": "^1.5.6",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.86.0"
  }
}
