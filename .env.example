# ==============================================================================
# FolloEat v4.1 - Environment Variables Reference
# ==============================================================================

# Google Places API Key (Opzionale: se omessa, il motore usa trasparente fallback su OSM Overpass API)
GOOGLE_PLACES_API_KEY=

# Stripe Connect Configuration (Opzionale in dev: se omessa, usa mock Auth & Capture a 5 minuti)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare D1 & KV (Configurati automaticamente tramite wrangler.toml quando deployato su Cloudflare Pages)
# DB=folloeat-db
# CACHE_KV=local-kv-id
